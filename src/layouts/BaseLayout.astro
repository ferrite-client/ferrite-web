---
import { currentReleaseCopy } from '../data/release';
import { navLinks } from '../data/product';
import '../styles/global.css';

interface Props { title?: string; description?: string; noindex?: boolean }
const { title = 'Ferrite — modded Minecraft, without the launcher mess.', description = 'A native Windows launcher for modded Minecraft instances, loaders, mods, modpacks, Java and diagnostics.', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://ferrite.emkacz.dev').toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ferrite" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://ferrite.emkacz.dev/og.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://ferrite.emkacz.dev/og.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Ferrite home"><span class="brand-mark" aria-hidden="true">F</span><span>Ferrite</span></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
      <nav id="site-nav" class="site-nav" aria-label="Primary navigation">
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        <a class="nav-github" href="https://github.com/ferrite-client/ferrite-client" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a class="nav-status" href="/download"><span class="status-dot" aria-hidden="true"></span>{currentReleaseCopy.label}</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-main">
        <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">F</span><span>Ferrite</span></a>
        <p>Native tools for the modded Minecraft player.</p>
        <div class="footer-links"><a href="/privacy">Privacy</a><a href="/docs">Docs</a><a href="/changelog">Changelog</a><a href="https://github.com/ferrite-client/ferrite-client" rel="noreferrer">Source ↗</a></div>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Ferrite</span><span>Ferrite is an independent project and is not affiliated with or endorsed by Mojang Studios or Microsoft.</span></div>
    </footer>
    <script is:inline>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('#site-nav');
      toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') === 'true'; toggle.setAttribute('aria-expanded', String(!open)); nav?.classList.toggle('is-open', !open); });
    </script>
  </body>
</html>
